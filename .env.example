NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/my_db?schema=public
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# WMS
WMS_APPROVAL_THRESHOLD=0
WMS_DEV_EVENT_ENDPOINT=0

# --- UMS JWT integration (RS256) ---
# Provide exactly one: inline key or key file path
# UMS_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----
# UMS_JWT_PUBLIC_KEY_PATH=/secrets/ums-jwt-public.pem

# --- Kafka (pos order events consumer) ---
# KAFKA_BROKERS=100.92.245.124:9092
# KAFKA_CONSUMER_GROUP_ID=wms-service-pos-events
# KAFKA_CONSUMER_DISABLED=false
